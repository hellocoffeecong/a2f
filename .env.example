# Copy to .env.local for local development. Never commit real values.
# On Vercel, set these in Project Settings → Environment Variables.

# --- Vercel Blob ---------------------------------------------------------
# Preferred: OIDC. On Vercel deployments VERCEL_OIDC_TOKEN is provided automatically.
# Locally, `vercel env pull .env.local` writes a short-lived VERCEL_OIDC_TOKEN
# (re-run the pull when it expires).
VERCEL_OIDC_TOKEN=
BLOB_STORE_ID=
# Fallback only, if OIDC cannot be used. Leave empty when OIDC works.
BLOB_READ_WRITE_TOKEN=

# --- Admin authentication -----------------------------------------------
ADMIN_USERNAME=
# Generate with: npm run hash-password -- '<password>'
ADMIN_PASSWORD_HASH=
# At least 32 random characters, e.g. `openssl rand -base64 48`
SESSION_SECRET=

# --- Public links ---------------------------------------------------------
NOTION_PUBLICATION_URL=
NEXT_PUBLIC_SITE_URL=
