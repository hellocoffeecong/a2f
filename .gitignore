# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# local analysis output (e.g. animation frame extraction)
/.tmp/

# Blob store exports made by scripts/blob-migrate.mjs (contain live data)
/migration-data/

# design reference files (SVG / PDF / MP4) are shared outside the repository
/references/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
